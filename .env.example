# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Telegram Bot Configuration (Server-side ONLY - never exposed to frontend)
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
BOT_USERNAME="YOUR_BOT_USERNAME"
APP_NAME="YOUR_APP_NAME"
MINI_APP_URL="YOUR_MINI_APP_URL"

# ImgBB API Key (Server-side ONLY - never exposed to frontend)
IMGBB_API_KEY="YOUR_IMGBB_API_KEY"

# AES-256-GCM Encryption Key for Firebase RTDB Data (64-char hex or passphrase)
DATA_ENCRYPTION_KEY="YOUR_64_CHAR_HEX_ENCRYPTION_KEY"

# Firebase Project Config (Server-side ONLY - never exposed to frontend)
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
FIREBASE_DATABASE_URL="https://YOUR_PROJECT-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
